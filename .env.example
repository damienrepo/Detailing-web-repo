# Public URL of the site, without trailing slash. Used for payment redirects,
# webhooks, e-mails and the sitemap. Must be https in production (secure cookies).
APP_URL="http://localhost:3000"
PORT=3000

# SQLite database file. Must be on persistent storage in production.
# Uploaded images are stored in an "uploads" folder next to it (or set UPLOADS_DIR).
DATABASE_PATH="data/shop.db"

# Key that encrypts stored secrets (Mollie key, mail password, 2FA secrets).
# Generate one with: npm run secret
# Without it, a key file is created next to the database. In production, set it
# here and keep it out of your backups, so a stolen backup alone reveals nothing.
SECRET_KEY=""

# --- Optional -------------------------------------------------------------------
# Mollie, e-mail and notifications are normally entered in /admin (Betalingen &
# e-mail). Anything set below takes precedence and shows as read-only there.
# MOLLIE_API_KEY=""
# SMTP_HOST=""
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=""
# SMTP_PASS=""
# MAIL_FROM="Detail2Go <no-reply@detail2go.nl>"
# NOTIFY_EMAIL=""
