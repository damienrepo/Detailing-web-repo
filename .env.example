# Public URL of the site, without trailing slash. Used for payment redirects,
# webhooks, e-mails and the sitemap.
APP_URL="http://localhost:3000"
PORT=3000

# Mollie API key (https://my.mollie.com > Developers > API keys).
# Use a test_ key first. Without a key, development uses a fake payment page
# and production disables checkout.
MOLLIE_API_KEY=""

# Password for /admin (orders and booking requests). Admin is disabled when empty.
ADMIN_PASSWORD=""

# SQLite database file. Must be on persistent storage in production.
DATABASE_PATH="data/shop.db"

# Outgoing e-mail. Without SMTP_HOST, e-mails are only logged to the console.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Lumen Detailing <no-reply@lumendetailing.nl>"
# Where new orders and booking requests are sent.
NOTIFY_EMAIL=""
